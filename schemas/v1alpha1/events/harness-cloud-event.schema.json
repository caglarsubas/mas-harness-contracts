{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/events/harness-cloud-event.schema.json",
  "title": "HarnessCloudEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["specversion", "id", "source", "type", "subject", "time", "datacontenttype", "dataschema", "organizationid", "partitionkey", "sequence", "data"],
  "properties": {
    "specversion": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
    "source": {"type": "string", "pattern": "^urn:planeon:harness:[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"},
    "type": {"enum": ["harness.approval.state.changed.v1", "harness.bundle-release.state.changed.v1", "harness.evidence.state.changed.v1", "harness.installation.state.changed.v1", "harness.operation.state.changed.v1", "harness.policy-bundle.state.changed.v1", "harness.status.projection.updated.v1"]},
    "subject": {"$ref": "../lifecycle/common.schema.json#/$defs/stableId"},
    "time": {"$ref": "../lifecycle/common.schema.json#/$defs/timestamp"},
    "datacontenttype": {"const": "application/json"},
    "dataschema": {"const": "https://harness.planeon.ai/schemas/v1alpha1/events/harness-cloud-event.schema.json"},
    "organizationid": {"$ref": "../lifecycle/common.schema.json#/$defs/stableId"},
    "partitionkey": {"$ref": "../lifecycle/common.schema.json#/$defs/stableId"},
    "sequence": {"type": "integer", "minimum": 1},
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "aggregateKind", "aggregateId", "aggregateVersion", "actor", "correlationId", "causationId", "reasonCode", "transition", "resourceRefs", "evidenceRefs"],
      "properties": {
        "schemaVersion": {"const": "harness.planeon.ai/event-data/v1alpha1"},
        "aggregateKind": {"enum": ["Operation", "ApprovalRequest", "BundleRelease", "HarnessInstallation", "EvidenceRecord", "PolicyBundle", "TenantHarnessOverview", "PlaneStatusProjection", "HarnessStatusProjection"]},
        "aggregateId": {"$ref": "../lifecycle/common.schema.json#/$defs/stableId"},
        "aggregateVersion": {"type": "integer", "minimum": 1},
        "actor": {"$ref": "../lifecycle/common.schema.json#/$defs/actor"},
        "correlationId": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "causationId": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}]},
        "reasonCode": {"$ref": "../lifecycle/common.schema.json#/$defs/reasonCode"},
        "transition": {
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["from", "to"],
              "properties": {
                "from": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"},
                "to": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"}
              }
            }
          ]
        },
        "resourceRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../lifecycle/common.schema.json#/$defs/resourceRef"}},
        "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "../lifecycle/common.schema.json#/$defs/resourceRef"}}
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"type": {"const": "harness.operation.state.changed.v1"}}, "required": ["type"]}, "then": {"properties": {"data": {"properties": {"aggregateKind": {"const": "Operation"}, "transition": {"type": "object"}}}}}},
    {"if": {"properties": {"type": {"const": "harness.approval.state.changed.v1"}}, "required": ["type"]}, "then": {"properties": {"data": {"properties": {"aggregateKind": {"const": "ApprovalRequest"}, "transition": {"type": "object"}}}}}},
    {"if": {"properties": {"type": {"const": "harness.bundle-release.state.changed.v1"}}, "required": ["type"]}, "then": {"properties": {"data": {"properties": {"aggregateKind": {"const": "BundleRelease"}, "transition": {"type": "object"}}}}}},
    {"if": {"properties": {"type": {"const": "harness.installation.state.changed.v1"}}, "required": ["type"]}, "then": {"properties": {"data": {"properties": {"aggregateKind": {"const": "HarnessInstallation"}, "transition": {"type": "object"}}}}}},
    {"if": {"properties": {"type": {"const": "harness.evidence.state.changed.v1"}}, "required": ["type"]}, "then": {"properties": {"data": {"properties": {"aggregateKind": {"const": "EvidenceRecord"}, "transition": {"type": "object"}}}}}},
    {"if": {"properties": {"type": {"const": "harness.policy-bundle.state.changed.v1"}}, "required": ["type"]}, "then": {"properties": {"data": {"properties": {"aggregateKind": {"const": "PolicyBundle"}, "transition": {"type": "object"}}}}}},
    {"if": {"properties": {"type": {"const": "harness.status.projection.updated.v1"}}, "required": ["type"]}, "then": {"properties": {"data": {"properties": {"aggregateKind": {"enum": ["TenantHarnessOverview", "PlaneStatusProjection", "HarnessStatusProjection"]}, "transition": {"type": "null"}}}}}}
  ]
}
