{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/taxonomy/catalog-document.schema.json",
  "title": "Planeon taxonomy catalog document",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "resources"],
  "properties": {
    "schemaVersion": {"const": "harness.planeon.ai/catalog-document/v1alpha1"},
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "harness-class-definition.schema.json"},
          {"$ref": "harness-module-definition.schema.json"},
          {"$ref": "framework-provider-definition.schema.json"},
          {"$ref": "module-release.schema.json"}
        ]
      }
    }
  }
}

