{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/taxonomy/harness-module-definition.schema.json",
  "title": "HarnessModuleDefinition",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "HarnessModuleDefinition"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harnessId",
        "providesCapabilities",
        "requiresModules",
        "conflicts",
        "installUnits",
        "compatibility",
        "resources",
        "license",
        "lifecycle",
        "externalEgressAllowed",
        "runtimeDownloadsAllowed"
      ],
      "properties": {
        "harnessId": {"$ref": "common.schema.json#/$defs/stableId"},
        "providesCapabilities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/stableId"}
        },
        "requiresModules": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/stableId"}
        },
        "conflicts": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/conflict"}
        },
        "installUnits": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "common.schema.json#/$defs/installUnit"}
        },
        "compatibility": {"$ref": "common.schema.json#/$defs/compatibility"},
        "resources": {"$ref": "common.schema.json#/$defs/resources"},
        "license": {"$ref": "common.schema.json#/$defs/license"},
        "lifecycle": {"$ref": "common.schema.json#/$defs/lifecycle"},
        "externalEgressAllowed": {"const": false},
        "runtimeDownloadsAllowed": {"const": false}
      }
    }
  }
}

