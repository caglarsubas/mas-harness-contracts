{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/model/rerank-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model",
    "query",
    "documents"
  ],
  "properties": {
    "model": {
      "$ref": "common.schema.json#/$defs/model"
    },
    "query": {
      "$ref": "common.schema.json#/$defs/text"
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "common.schema.json#/$defs/text"
      }
    },
    "top_n": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128,
      "default": 1
    }
  }
}
