{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/model/rerank-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "model",
    "results",
    "usage"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "model": {
      "$ref": "common.schema.json#/$defs/model"
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "relevance_score"
        ],
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "relevance_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "usage": {
      "$ref": "common.schema.json#/$defs/embeddingUsage"
    }
  }
}
