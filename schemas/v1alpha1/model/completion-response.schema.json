{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/model/completion-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "object",
    "created",
    "model",
    "choices",
    "usage"
  ],
  "properties": {
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "object": {
      "const": "text_completion"
    },
    "created": {
      "type": "integer",
      "minimum": 0,
      "maximum": 253402300799
    },
    "model": {
      "$ref": "common.schema.json#/$defs/model"
    },
    "choices": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "index",
          "text",
          "finish_reason",
          "logprobs"
        ],
        "properties": {
          "index": {
            "const": 0
          },
          "text": {
            "$ref": "common.schema.json#/$defs/outputText"
          },
          "finish_reason": {
            "enum": [
              "stop",
              "length"
            ]
          },
          "logprobs": {
            "type": "null"
          }
        }
      }
    },
    "usage": {
      "$ref": "common.schema.json#/$defs/usage"
    }
  }
}
