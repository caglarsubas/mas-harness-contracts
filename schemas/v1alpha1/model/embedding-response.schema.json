{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/model/embedding-response.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object",
    "model",
    "data",
    "usage"
  ],
  "properties": {
    "object": {
      "const": "list"
    },
    "model": {
      "$ref": "common.schema.json#/$defs/model"
    },
    "data": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "object",
          "index",
          "embedding"
        ],
        "properties": {
          "object": {
            "const": "embedding"
          },
          "index": {
            "type": "integer",
            "minimum": 0,
            "maximum": 127
          },
          "embedding": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "number",
              "minimum": -1000000,
              "maximum": 1000000
            }
          }
        }
      }
    },
    "usage": {
      "$ref": "common.schema.json#/$defs/embeddingUsage"
    }
  }
}
