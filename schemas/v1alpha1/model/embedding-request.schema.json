{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/model/embedding-request.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model",
    "input"
  ],
  "properties": {
    "model": {
      "$ref": "common.schema.json#/$defs/model"
    },
    "input": {
      "oneOf": [
        {
          "$ref": "common.schema.json#/$defs/text"
        },
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "$ref": "common.schema.json#/$defs/text"
          }
        }
      ]
    },
    "encoding_format": {
      "const": "float",
      "default": "float"
    },
    "dimensions": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4096
    }
  }
}
