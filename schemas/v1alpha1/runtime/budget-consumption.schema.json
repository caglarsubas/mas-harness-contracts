{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/runtime/budget-consumption.schema.json",
  "title": "BudgetConsumption",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "BudgetConsumption"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "budgetDigest", "admissionDigest", "limits", "observed", "decision", "exceededDimensions", "recordedAt"],
      "properties": {
        "organizationId": {"$ref": "common.schema.json#/$defs/stableId"},
        "budgetDigest": {"$ref": "common.schema.json#/$defs/sha256"},
        "admissionDigest": {"$ref": "common.schema.json#/$defs/sha256"},
        "limits": {"$ref": "common.schema.json#/$defs/budgetLimits"},
        "observed": {"$ref": "common.schema.json#/$defs/budgetObserved"},
        "decision": {"enum": ["WITHIN_BUDGET", "OVER_BUDGET"]},
        "exceededDimensions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["CONCURRENT_TASKS", "TASK_SECONDS", "RETRIES", "TOOL_CALLS", "MODEL_TOKENS"]}
        },
        "recordedAt": {"$ref": "common.schema.json#/$defs/timestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "WITHIN_BUDGET"}}, "required": ["decision"]},
          "then": {"properties": {"exceededDimensions": {"maxItems": 0}}},
          "else": {"properties": {"exceededDimensions": {"minItems": 1}}}
        }
      ]
    }
  }
}
