{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/runtime/runtime-trust-bundle.schema.json",
  "title": "RuntimeTrustBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "payload", "signature"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "RuntimeTrustBundle"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "bundleVersion", "issuedAt", "validFrom", "validUntil", "previousBundleDigest", "keys"],
      "properties": {
        "organizationId": {"$ref": "common.schema.json#/$defs/stableId"},
        "bundleVersion": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "issuedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "validFrom": {"$ref": "common.schema.json#/$defs/timestamp"},
        "validUntil": {"$ref": "common.schema.json#/$defs/timestamp"},
        "previousBundleDigest": {
          "oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/sha256"}]
        },
        "keys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["keyId", "algorithm", "publicKey", "purposes", "state", "notBefore", "notAfter", "revokedAt", "revocationReason"],
            "properties": {
              "keyId": {"$ref": "common.schema.json#/$defs/stableId"},
              "algorithm": {"const": "ED25519"},
              "publicKey": {"$ref": "common.schema.json#/$defs/base64urlPublicKey"},
              "purposes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"$ref": "common.schema.json#/$defs/keyPurpose"}
              },
              "state": {"enum": ["PENDING", "ACTIVE", "RETIRED", "REVOKED"]},
              "notBefore": {"$ref": "common.schema.json#/$defs/timestamp"},
              "notAfter": {"$ref": "common.schema.json#/$defs/timestamp"},
              "revokedAt": {
                "oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/timestamp"}]
              },
              "revocationReason": {
                "oneOf": [
                  {"type": "null"},
                  {"enum": ["KEY_COMPROMISE", "AUTHORITY_WITHDRAWN", "SUPERSEDED", "POLICY_VIOLATION"]}
                ]
              }
            },
            "allOf": [
              {
                "if": {"properties": {"state": {"const": "REVOKED"}}, "required": ["state"]},
                "then": {
                  "properties": {
                    "revokedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
                    "revocationReason": {"enum": ["KEY_COMPROMISE", "AUTHORITY_WITHDRAWN", "SUPERSEDED", "POLICY_VIOLATION"]}
                  }
                },
                "else": {
                  "properties": {
                    "revokedAt": {"type": "null"},
                    "revocationReason": {"type": "null"}
                  }
                }
              }
            ]
          }
        }
      }
    },
    "signature": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/signature"},
        {"properties": {"purpose": {"const": "TRUST_BUNDLE"}}}
      ]
    }
  }
}
