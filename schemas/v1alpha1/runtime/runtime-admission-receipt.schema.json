{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/runtime/runtime-admission-receipt.schema.json",
  "title": "RuntimeAdmissionReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "payload", "signature"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "RuntimeAdmissionReceipt"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "payload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "receiptId", "admissionDigest", "requestDigest", "trustBundleDigest", "decision", "reasonCode", "budgetConsumptionDigest", "replayRecordDigest", "decidedAt", "expiresAt"],
      "properties": {
        "organizationId": {"$ref": "common.schema.json#/$defs/stableId"},
        "receiptId": {"$ref": "common.schema.json#/$defs/stableId"},
        "admissionDigest": {"$ref": "common.schema.json#/$defs/sha256"},
        "requestDigest": {"$ref": "common.schema.json#/$defs/sha256"},
        "trustBundleDigest": {"$ref": "common.schema.json#/$defs/sha256"},
        "decision": {"enum": ["ADMIT", "DENY"]},
        "reasonCode": {
          "oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/denialReason"}]
        },
        "budgetConsumptionDigest": {
          "oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/sha256"}]
        },
        "replayRecordDigest": {
          "oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/sha256"}]
        },
        "decidedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "expiresAt": {"$ref": "common.schema.json#/$defs/timestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"decision": {"const": "ADMIT"}}, "required": ["decision"]},
          "then": {
            "properties": {
              "reasonCode": {"type": "null"},
              "budgetConsumptionDigest": {"$ref": "common.schema.json#/$defs/sha256"},
              "replayRecordDigest": {"$ref": "common.schema.json#/$defs/sha256"}
            }
          },
          "else": {
            "properties": {
              "reasonCode": {"$ref": "common.schema.json#/$defs/denialReason"}
            }
          }
        }
      ]
    },
    "signature": {
      "allOf": [
        {"$ref": "common.schema.json#/$defs/signature"},
        {"properties": {"purpose": {"const": "RUNTIME_RECEIPT"}}}
      ]
    }
  }
}
