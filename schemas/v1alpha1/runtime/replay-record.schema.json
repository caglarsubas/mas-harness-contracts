{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/runtime/replay-record.schema.json",
  "title": "ReplayRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "ReplayRecord"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "replayKeyDigest", "idempotencyKeyDigest", "nonceDigest", "admissionDigest", "requestDigest", "state", "firstSeenAt", "updatedAt", "expiresAt", "receiptDigest"],
      "properties": {
        "organizationId": {"$ref": "common.schema.json#/$defs/stableId"},
        "replayKeyDigest": {"$ref": "common.schema.json#/$defs/sha256"},
        "idempotencyKeyDigest": {"$ref": "common.schema.json#/$defs/sha256"},
        "nonceDigest": {"$ref": "common.schema.json#/$defs/sha256"},
        "admissionDigest": {"$ref": "common.schema.json#/$defs/sha256"},
        "requestDigest": {"$ref": "common.schema.json#/$defs/sha256"},
        "state": {"enum": ["RESERVED", "COMMITTED", "REJECTED", "EXPIRED"]},
        "firstSeenAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "updatedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "expiresAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "receiptDigest": {
          "oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/sha256"}]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "RESERVED"}}, "required": ["state"]},
          "then": {"properties": {"receiptDigest": {"type": "null"}}}
        },
        {
          "if": {"properties": {"state": {"enum": ["COMMITTED", "REJECTED"]}}, "required": ["state"]},
          "then": {"properties": {"receiptDigest": {"$ref": "common.schema.json#/$defs/sha256"}}}
        }
      ]
    }
  }
}
