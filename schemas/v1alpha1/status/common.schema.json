{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/status/common.schema.json",
  "$defs": {
    "apiVersion": {"const": "harness.planeon.ai/v1alpha1"},
    "stableId": {"$ref": "../composition/common.schema.json#/$defs/stableId"},
    "semver": {"$ref": "../composition/common.schema.json#/$defs/semver"},
    "sha256": {"$ref": "../composition/common.schema.json#/$defs/sha256"},
    "timestamp": {"$ref": "../lifecycle/common.schema.json#/$defs/timestamp"},
    "reasonCode": {"$ref": "../lifecycle/common.schema.json#/$defs/reasonCode"},
    "metadata": {"$ref": "../lifecycle/common.schema.json#/$defs/metadata"},
    "selectionState": {"enum": ["NOT_SELECTED", "PROPOSED", "SELECTED", "BLOCKED"]},
    "installationState": {"enum": ["ABSENT", "PENDING", "PREFLIGHT", "VERIFYING", "APPLYING", "HEALTH_CHECKING", "READY", "BLOCKED", "DEGRADED", "FAILED", "UPGRADING", "ROLLING_BACK", "UNINSTALLING", "REMOVED", "RETIRED", "REVOKED"]},
    "evidenceState": {"enum": ["NOT_APPLICABLE", "MISSING", "COLLECTING", "PASS", "WARN", "FAIL", "STALE", "WAIVED", "NOT_RUN_ENV_UNAVAILABLE"]},
    "nonWaivedEvidenceState": {"enum": ["NOT_APPLICABLE", "MISSING", "COLLECTING", "PASS", "WARN", "FAIL", "STALE", "NOT_RUN_ENV_UNAVAILABLE"]},
    "freshnessState": {"enum": ["CURRENT", "STALE", "SOURCE_UNAVAILABLE"]},
    "aggregateState": {"enum": ["EMPTY", "READY", "DEGRADED", "BLOCKED", "FAILED", "REVOKED"]},
    "evidenceAxis": {"enum": ["SOURCE", "CONTRACT_UNIT", "PR_CHECK", "MERGE", "ARTIFACT_SBOM", "SIGNATURE_RELEASE", "DEPLOYMENT", "RUNTIME", "SECURITY", "ASSURANCE", "TENANT_ACCEPTANCE"]},
    "sourceCursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceId", "cursor", "observedAt", "state"],
      "properties": {
        "sourceId": {"$ref": "#/$defs/stableId"},
        "cursor": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9._:-]+$"},
        "observedAt": {"$ref": "#/$defs/timestamp"},
        "state": {"enum": ["CURRENT", "SOURCE_UNAVAILABLE"]}
      }
    },
    "projectionBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "profileDigest", "bundleDigest", "releaseDigest", "observedGeneration", "projectedAt", "freshUntil", "sourceCursors", "projectionSchemaVersion"],
      "properties": {
        "organizationId": {"$ref": "#/$defs/stableId"},
        "profileDigest": {"$ref": "#/$defs/sha256"},
        "bundleDigest": {"$ref": "#/$defs/sha256"},
        "releaseDigest": {"$ref": "#/$defs/sha256"},
        "observedGeneration": {"type": "integer", "minimum": 1},
        "projectedAt": {"$ref": "#/$defs/timestamp"},
        "freshUntil": {"$ref": "#/$defs/timestamp"},
        "sourceCursors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceCursor"}},
        "projectionSchemaVersion": {"const": "harness.planeon.ai/status-projection/v1alpha1"}
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "projectedAt", "freshUntil", "sourceCursors"],
      "properties": {
        "state": {"$ref": "#/$defs/freshnessState"},
        "projectedAt": {"$ref": "#/$defs/timestamp"},
        "freshUntil": {"$ref": "#/$defs/timestamp"},
        "sourceCursors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/sourceCursor"}}
      }
    },
    "resourceRef": {"$ref": "../lifecycle/common.schema.json#/$defs/resourceRef"},
    "waiver": {
      "type": "object",
      "additionalProperties": false,
      "required": ["waiverId", "waiverDigest", "approvedBy", "expiresAt", "basisCode"],
      "properties": {
        "waiverId": {"$ref": "#/$defs/stableId"},
        "waiverDigest": {"$ref": "#/$defs/sha256"},
        "approvedBy": {"$ref": "#/$defs/stableId"},
        "expiresAt": {"$ref": "#/$defs/timestamp"},
        "basisCode": {"$ref": "#/$defs/reasonCode"}
      }
    },
    "applicability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode", "contractRef"],
      "properties": {
        "reasonCode": {"$ref": "#/$defs/reasonCode"},
        "contractRef": {"$ref": "#/$defs/resourceRef"}
      }
    },
    "statusAxis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "required", "state", "underlyingState", "observedAt", "evidenceRefs", "waiver", "applicability"],
      "properties": {
        "axis": {"$ref": "#/$defs/evidenceAxis"},
        "required": {"type": "boolean"},
        "state": {"$ref": "#/$defs/evidenceState"},
        "underlyingState": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/nonWaivedEvidenceState"}]},
        "observedAt": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/timestamp"}]},
        "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/resourceRef"}},
        "waiver": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/waiver"}]},
        "applicability": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/applicability"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "WAIVED"}}, "required": ["state"]},
          "then": {
            "properties": {
              "underlyingState": {"enum": ["MISSING", "COLLECTING", "WARN", "FAIL", "STALE", "NOT_RUN_ENV_UNAVAILABLE"]},
              "waiver": {"$ref": "#/$defs/waiver"}
            }
          },
          "else": {"properties": {"underlyingState": {"type": "null"}, "waiver": {"type": "null"}}}
        },
        {
          "if": {"properties": {"state": {"const": "NOT_APPLICABLE"}}, "required": ["state"]},
          "then": {"properties": {"applicability": {"$ref": "#/$defs/applicability"}}},
          "else": {"properties": {"applicability": {"type": "null"}}}
        }
      ]
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["findingId", "severity", "reasonCode", "affectedAxis", "ownerRef", "blocking", "evidenceRefs", "permittedActions"],
      "properties": {
        "findingId": {"$ref": "#/$defs/stableId"},
        "severity": {"enum": ["INFO", "WARN", "ERROR", "CRITICAL"]},
        "reasonCode": {"$ref": "#/$defs/reasonCode"},
        "affectedAxis": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/evidenceAxis"}]},
        "ownerRef": {"$ref": "#/$defs/stableId"},
        "blocking": {"type": "boolean"},
        "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/resourceRef"}},
        "permittedActions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["REQUEST_EVIDENCE", "REFRESH_PROJECTION", "REVIEW_WAIVER", "RETRY_OPERATION", "ROLLBACK", "RESOLVE_DEPENDENCY", "CONTACT_OWNER", "NONE"]}
        }
      }
    },
    "harnessSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harnessId", "planeId", "selectionState", "installationState", "aggregateState", "highestEvidenceState", "freshnessState", "blockerCount", "reasonCode"],
      "properties": {
        "harnessId": {"$ref": "#/$defs/stableId"},
        "planeId": {"enum": ["runtime", "knowledge", "execution", "trust"]},
        "selectionState": {"$ref": "#/$defs/selectionState"},
        "installationState": {"$ref": "#/$defs/installationState"},
        "aggregateState": {"$ref": "#/$defs/aggregateState"},
        "highestEvidenceState": {"$ref": "#/$defs/evidenceState"},
        "freshnessState": {"$ref": "#/$defs/freshnessState"},
        "blockerCount": {"type": "integer", "minimum": 0},
        "reasonCode": {"$ref": "#/$defs/reasonCode"}
      }
    },
    "planeSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planeId", "aggregateState", "selectedCount", "notSelectedCount", "worstInstallationState", "freshnessState", "blockingDependencyCount", "harnesses"],
      "properties": {
        "planeId": {"enum": ["runtime", "knowledge", "execution", "trust"]},
        "aggregateState": {"$ref": "#/$defs/aggregateState"},
        "selectedCount": {"type": "integer", "minimum": 0, "maximum": 4},
        "notSelectedCount": {"type": "integer", "minimum": 0, "maximum": 4},
        "worstInstallationState": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/installationState"}]},
        "freshnessState": {"$ref": "#/$defs/freshnessState"},
        "blockingDependencyCount": {"type": "integer", "minimum": 0},
        "harnesses": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"$ref": "#/$defs/harnessSummary"}}
      }
    },
    "stateCount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "count"],
      "properties": {
        "state": {"type": "string", "minLength": 1},
        "count": {"type": "integer", "minimum": 0}
      }
    }
  }
}
