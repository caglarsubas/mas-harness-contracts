{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/lifecycle/common.schema.json",
  "$defs": {
    "apiVersion": {"const": "harness.planeon.ai/v1alpha1"},
    "stableId": {"$ref": "../composition/common.schema.json#/$defs/stableId"},
    "semver": {"$ref": "../composition/common.schema.json#/$defs/semver"},
    "sha256": {"$ref": "../composition/common.schema.json#/$defs/sha256"},
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "reasonCode": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)*$"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "version": {"$ref": "#/$defs/semver"}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["HUMAN", "WORKLOAD", "SYSTEM", "TENANT"]},
        "id": {"$ref": "#/$defs/stableId"}
      }
    },
    "resourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "digest"],
      "properties": {
        "kind": {"$ref": "#/$defs/stableId"},
        "id": {"$ref": "#/$defs/stableId"},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "immutableBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "profileDigest", "bundleDigest", "releaseDigest"],
      "properties": {
        "organizationId": {"$ref": "#/$defs/stableId"},
        "profileDigest": {"$ref": "#/$defs/sha256"},
        "bundleDigest": {"$ref": "#/$defs/sha256"},
        "releaseDigest": {"$ref": "#/$defs/sha256"}
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasonCode", "retryable", "evidenceRefs"],
      "properties": {
        "reasonCode": {"$ref": "#/$defs/reasonCode"},
        "retryable": {"type": "boolean"},
        "evidenceRefs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/resourceRef"}
        }
      }
    }
  }
}
