{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/lifecycle/evidence-record.schema.json",
  "title": "EvidenceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "EvidenceRecord"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "recordState", "axis", "result", "subject", "producer", "producerAuthority", "evidenceDigest", "provenanceDigest", "collectedAt", "validUntil", "controlIds", "campaignGenerated"],
      "properties": {
        "organizationId": {"$ref": "common.schema.json#/$defs/stableId"},
        "recordState": {"enum": ["RECEIVED", "VERIFIED", "REJECTED", "SUPERSEDED", "REVOKED"]},
        "axis": {"enum": ["SOURCE", "CONTRACT_UNIT", "PR_CHECK", "MERGE", "ARTIFACT_SBOM", "SIGNATURE_RELEASE", "DEPLOYMENT", "RUNTIME", "SECURITY", "ASSURANCE", "TENANT_ACCEPTANCE"]},
        "result": {"enum": ["PASS", "WARN", "FAIL", "NOT_RUN_ENV_UNAVAILABLE"]},
        "subject": {"$ref": "common.schema.json#/$defs/resourceRef"},
        "producer": {"$ref": "common.schema.json#/$defs/actor"},
        "producerAuthority": {"enum": ["PLATFORM", "TENANT", "INDEPENDENT"]},
        "evidenceDigest": {"$ref": "common.schema.json#/$defs/sha256"},
        "provenanceDigest": {"$ref": "common.schema.json#/$defs/sha256"},
        "collectedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "validUntil": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/timestamp"}]},
        "controlIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stableId"}},
        "campaignGenerated": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"axis": {"const": "TENANT_ACCEPTANCE"}}, "required": ["axis"]},
          "then": {"properties": {"producerAuthority": {"const": "TENANT"}, "campaignGenerated": {"const": false}}}
        }
      ]
    }
  }
}
