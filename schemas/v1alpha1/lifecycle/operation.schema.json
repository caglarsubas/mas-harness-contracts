{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/lifecycle/operation.schema.json",
  "title": "Operation",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "Operation"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "operationType", "state", "subject", "actor", "idempotencyKeyDigest", "requestedAt", "updatedAt", "observedVersion", "cancellable", "resultRefs", "failure"],
      "properties": {
        "organizationId": {"$ref": "common.schema.json#/$defs/stableId"},
        "operationType": {"enum": ["COMPILE_PROFILE", "LOCK_PROFILE", "BUILD_BUNDLE", "INSTALL", "UPGRADE", "ROLLBACK", "UNINSTALL", "VERIFY_EVIDENCE"]},
        "state": {"enum": ["PENDING", "RUNNING", "CANCELLING", "SUCCEEDED", "FAILED", "CANCELLED"]},
        "subject": {"$ref": "common.schema.json#/$defs/resourceRef"},
        "actor": {"$ref": "common.schema.json#/$defs/actor"},
        "idempotencyKeyDigest": {"$ref": "common.schema.json#/$defs/sha256"},
        "requestedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "updatedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "observedVersion": {"type": "integer", "minimum": 1},
        "cancellable": {"type": "boolean"},
        "resultRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/resourceRef"}},
        "failure": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/failure"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"const": "FAILED"}}, "required": ["state"]},
          "then": {"properties": {"failure": {"$ref": "common.schema.json#/$defs/failure"}}},
          "else": {"properties": {"failure": {"type": "null"}}}
        },
        {
          "if": {"properties": {"state": {"enum": ["SUCCEEDED", "FAILED", "CANCELLED"]}}, "required": ["state"]},
          "then": {"properties": {"cancellable": {"const": false}}}
        }
      ]
    }
  }
}
