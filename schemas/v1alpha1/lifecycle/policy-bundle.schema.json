{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/lifecycle/policy-bundle.schema.json",
  "title": "PolicyBundle",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "PolicyBundle"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "state", "policyDigest", "signatureDigest", "effectiveAt", "expiresAt", "supersedesPolicyDigest"],
      "properties": {
        "organizationId": {"$ref": "common.schema.json#/$defs/stableId"},
        "state": {"enum": ["DRAFT", "VALIDATED", "SIGNED", "ACTIVE", "REJECTED", "RETIRED", "REVOKED"]},
        "policyDigest": {"$ref": "common.schema.json#/$defs/sha256"},
        "signatureDigest": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/sha256"}]},
        "effectiveAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "expiresAt": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/timestamp"}]},
        "supersedesPolicyDigest": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/sha256"}]}
      },
      "allOf": [
        {
          "if": {"properties": {"state": {"enum": ["SIGNED", "ACTIVE", "RETIRED", "REVOKED"]}}, "required": ["state"]},
          "then": {"properties": {"signatureDigest": {"$ref": "common.schema.json#/$defs/sha256"}}}
        }
      ]
    }
  }
}
