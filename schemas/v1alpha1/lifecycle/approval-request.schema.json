{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/lifecycle/approval-request.schema.json",
  "title": "ApprovalRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "ApprovalRequest"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizationId", "approvalType", "state", "subject", "policyRef", "requiredDecisions", "requestedBy", "requestedAt", "expiresAt", "decisions", "reasonCode"],
      "properties": {
        "organizationId": {"$ref": "common.schema.json#/$defs/stableId"},
        "approvalType": {"enum": ["DEMAND", "PROFILE", "BUNDLE", "MUTATION", "WAIVER", "TENANT_ACCEPTANCE"]},
        "state": {"enum": ["PENDING", "APPROVED", "REJECTED", "EXPIRED", "CANCELLED"]},
        "subject": {"$ref": "common.schema.json#/$defs/resourceRef"},
        "policyRef": {"$ref": "common.schema.json#/$defs/resourceRef"},
        "requiredDecisions": {"type": "integer", "minimum": 1, "maximum": 32},
        "requestedBy": {"$ref": "common.schema.json#/$defs/actor"},
        "requestedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "expiresAt": {"$ref": "common.schema.json#/$defs/timestamp"},
        "decisions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["actor", "decision", "decidedAt", "reasonCode"],
            "properties": {
              "actor": {"$ref": "common.schema.json#/$defs/actor"},
              "decision": {"enum": ["APPROVE", "REJECT"]},
              "decidedAt": {"$ref": "common.schema.json#/$defs/timestamp"},
              "reasonCode": {"$ref": "common.schema.json#/$defs/reasonCode"}
            }
          }
        },
        "reasonCode": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/reasonCode"}]}
      }
    }
  }
}
