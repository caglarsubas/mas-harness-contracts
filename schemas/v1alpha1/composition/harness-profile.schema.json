{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/composition/harness-profile.schema.json",
  "title": "HarnessProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "HarnessProfile"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "tenantId", "catalogDigest", "tenantDemandId", "readinessAssessmentId", "readinessStatus", "requestedCapabilities", "directHarnessIds", "selectedHarnessIds", "acceptedPrerequisiteHarnessIds", "selectedModuleIds", "selectedProviderIds", "providerSelections", "proposedSelectors", "assuranceSubjects", "executionBudgetId", "environmentAttestationDigest"],
      "properties": {
        "state": {"const": "PLANNED"},
        "tenantId": {"$ref": "common.schema.json#/$defs/stableId"},
        "catalogDigest": {"$ref": "common.schema.json#/$defs/sha256"},
        "tenantDemandId": {"$ref": "common.schema.json#/$defs/stableId"},
        "readinessAssessmentId": {"$ref": "common.schema.json#/$defs/stableId"},
        "readinessStatus": {"const": "READY"},
        "requestedCapabilities": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stableId"}},
        "directHarnessIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stableId"}},
        "selectedHarnessIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stableId"}},
        "acceptedPrerequisiteHarnessIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stableId"}},
        "selectedModuleIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stableId"}},
        "selectedProviderIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stableId"}},
        "providerSelections": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/providerSelection"}},
        "proposedSelectors": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/selectorProposal"}},
        "assuranceSubjects": {"$ref": "common.schema.json#/$defs/assuranceSubjects"},
        "executionBudgetId": {"$ref": "common.schema.json#/$defs/stableId"},
        "environmentAttestationDigest": {"$ref": "common.schema.json#/$defs/sha256"}
      }
    }
  }
}
