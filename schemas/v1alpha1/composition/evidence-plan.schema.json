{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/composition/evidence-plan.schema.json",
  "title": "EvidencePlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "EvidencePlan"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "profileId", "harnessRequirements", "productionGates", "assuranceSubjects", "evidenceState", "tenantAcceptanceIncluded"],
      "properties": {
        "state": {"const": "PLANNED"},
        "profileId": {"$ref": "common.schema.json#/$defs/stableId"},
        "harnessRequirements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["harnessId", "evidenceTypes"],
            "properties": {
              "harnessId": {"$ref": "common.schema.json#/$defs/stableId"},
              "evidenceTypes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["SOURCE", "CI", "ARTIFACT", "DEPLOYMENT", "RUNTIME", "SECURITY", "ASSURANCE"]}}
            }
          }
        },
        "productionGates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["harnessId", "gateId"],
            "properties": {
              "harnessId": {"$ref": "common.schema.json#/$defs/stableId"},
              "gateId": {"$ref": "common.schema.json#/$defs/stableId"}
            }
          }
        },
        "assuranceSubjects": {"$ref": "common.schema.json#/$defs/assuranceSubjects"},
        "evidenceState": {"const": "MISSING_PLANNED"},
        "tenantAcceptanceIncluded": {"const": false}
      }
    }
  }
}
