{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/composition/install-plan.schema.json",
  "title": "InstallPlan",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "InstallPlan"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "profileId", "waves", "healthCheckRequired", "rollbackRequired", "uninstallSupported", "tenantDataRetention"],
      "properties": {
        "state": {"const": "PLANNED"},
        "profileId": {"$ref": "common.schema.json#/$defs/stableId"},
        "waves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["index", "resourceIds"],
            "properties": {
              "index": {"type": "integer", "minimum": 0},
              "resourceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stableId"}}
            }
          }
        },
        "healthCheckRequired": {"const": true},
        "rollbackRequired": {"const": true},
        "uninstallSupported": {"const": true},
        "tenantDataRetention": {"const": "RETAIN_BY_DEFAULT"}
      }
    }
  }
}
