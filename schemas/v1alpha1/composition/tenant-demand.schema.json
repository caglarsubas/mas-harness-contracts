{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/composition/tenant-demand.schema.json",
  "title": "TenantDemand",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "TenantDemand"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["questionnaireAnswerSetId", "readinessAssessmentId", "requestedCapabilities", "acceptedPrerequisiteHarnessIds", "environment", "assuranceSubjects", "executionBudget"],
      "properties": {
        "questionnaireAnswerSetId": {"$ref": "common.schema.json#/$defs/stableId"},
        "readinessAssessmentId": {"$ref": "common.schema.json#/$defs/stableId"},
        "requestedCapabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stableId"}},
        "acceptedPrerequisiteHarnessIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stableId"}},
        "environment": {"$ref": "common.schema.json#/$defs/environment"},
        "assuranceSubjects": {"$ref": "common.schema.json#/$defs/assuranceSubjects"},
        "executionBudget": {"$ref": "common.schema.json#/$defs/executionBudgetSpec"}
      }
    }
  }
}
