{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/composition/compile-request.schema.json",
  "title": "CompileRequest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "metadata", "questionnaireAnswerSet", "readinessAssessment", "demand"],
  "properties": {
    "schemaVersion": {"const": "harness.planeon.ai/compile-request/v1alpha1"},
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tenantId", "demandId", "profileId", "version"],
      "properties": {
        "tenantId": {"$ref": "common.schema.json#/$defs/stableId"},
        "demandId": {"$ref": "common.schema.json#/$defs/stableId"},
        "profileId": {"$ref": "common.schema.json#/$defs/stableId"},
        "version": {"$ref": "common.schema.json#/$defs/semver"}
      }
    },
    "questionnaireAnswerSet": {"$ref": "../guidance/questionnaire-answer-set.schema.json"},
    "readinessAssessment": {"$ref": "../readiness/data-readiness-assessment.schema.json"},
    "demand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requestedCapabilities", "acceptedPrerequisiteHarnessIds", "environment", "assuranceSubjects", "executionBudget"],
      "properties": {
        "requestedCapabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stableId"}},
        "acceptedPrerequisiteHarnessIds": {"type": "array", "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/stableId"}},
        "environment": {"$ref": "common.schema.json#/$defs/environment"},
        "assuranceSubjects": {"$ref": "common.schema.json#/$defs/assuranceSubjects"},
        "executionBudget": {"$ref": "common.schema.json#/$defs/executionBudgetSpec"}
      }
    }
  }
}
