{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness.planeon.ai/schemas/v1alpha1/composition/bill-of-materials.schema.json",
  "title": "BillOfMaterials",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"$ref": "common.schema.json#/$defs/apiVersion"},
    "kind": {"const": "BillOfMaterials"},
    "metadata": {"$ref": "common.schema.json#/$defs/metadata"},
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "profileId", "catalogDigest", "entries"],
      "properties": {
        "state": {"const": "PLANNED"},
        "profileId": {"$ref": "common.schema.json#/$defs/stableId"},
        "catalogDigest": {"$ref": "common.schema.json#/$defs/sha256"},
        "entries": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["resourceId", "resourceKind", "harnessId", "sourceVersion", "installUnits"],
            "properties": {
              "resourceId": {"$ref": "common.schema.json#/$defs/stableId"},
              "resourceKind": {"enum": ["MODULE", "PROVIDER"]},
              "harnessId": {"$ref": "common.schema.json#/$defs/stableId"},
              "sourceVersion": {"$ref": "common.schema.json#/$defs/semver"},
              "installUnits": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/installUnit"}}
            }
          }
        }
      }
    }
  }
}
