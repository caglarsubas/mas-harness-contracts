{
  "openapi": "3.1.1",
  "info": {"title": "Planeon Harness Distribution Release API", "version": "0.1.0", "license": {"name": "Apache-2.0"}},
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "paths": {
    "/api/v1alpha1/releases/{releaseId}": {
      "get": {
        "operationId": "getBundleRelease",
        "summary": "Read one immutable bundle release lifecycle record",
        "security": [{"workloadIdentity": []}],
        "parameters": [{"name": "releaseId", "in": "path", "required": true, "schema": {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$"}}],
        "responses": {"200": {"description": "Bundle release", "content": {"application/json": {"schema": {"$ref": "../schemas/v1alpha1/lifecycle/bundle-release.schema.json"}}}}, "404": {"description": "Release not found"}}
      }
    }
  },
  "components": {"securitySchemes": {"workloadIdentity": {"type": "mutualTLS"}}}
}
